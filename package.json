{
  "name": "nallyhermes",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "A Telegram-first AI agent with a custom orchestration engine, long-term memory, and proactive scheduling.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "NALLY_DATABASE_INTEGRATION_URL=\"${NALLY_DATABASE_INTEGRATION_URL:-}\" tsx --test tests/database.integration.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.38.2",
    "openai": "^7.53.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
