# Telegram
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the deployed Render Web Service
WEBHOOK_URL=https://your-service.onrender.com
# Generate a random secret (at least 32 characters; letters, numbers, _ and -)
WEBHOOK_SECRET=
PORT=3000

# NVIDIA NIM (OpenAI-compatible API)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional model-specific NVIDIA hosted reranker endpoint overrides
# Defaults use NVIDIA's hosted NeMo Retriever routes.
# NVIDIA_NIM_NEMOTRON_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
# NVIDIA_NIM_LLAMA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Neon PostgreSQL
DATABASE_URL=

# Default timezone for new Telegram users (IANA timezone)
DEFAULT_TIMEZONE=Africa/Lagos

# Tavily web search
TAVILY_API_KEY=

# LightRAG memory service (enable only after deploying the Python service)
LIGHTRAG_ENABLED=false
LIGHTRAG_URL=http://127.0.0.1:9621
LIGHTRAG_API_TOKEN=

# NVIDIA NIM embeddings for LightRAG
LIGHTRAG_LLM_MODEL=
LIGHTRAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
LIGHTRAG_EMBEDDING_DIM=2048

# File workspace (local directory for isolated user files)
FILE_WORKSPACE=./workspace

# Agent execution budgets (all values have safe upper bounds in config validation)
AGENT_MAX_MODEL_ROUNDS=12
AGENT_MAX_PLAN_TOOL_ROUNDS=60
AGENT_MAX_STEP_TOOL_ROUNDS=15
AGENT_MAX_PARALLEL_PLAN_STEPS=5
AGENT_MAX_PARALLEL_TOOL_CALLS=5
AGENT_PLAN_TIMEOUT_MS=480000
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MAX_READ_RETRIES=2

# Runtime
NODE_ENV=development
LOG_LEVEL=info
